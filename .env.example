# Course selection (optional — defaults to marine_park)
COURSE=marine_park

# Target date override (optional — defaults to today + 7 days)
# TARGET_DATE=2026-06-04

# Number of players (1-4)
PLAYERS=2

# Preferred tee time window (24-hour HH:MM)
EARLIEST_TIME=07:00
LATEST_TIME=09:00

# Set to true to log available times without completing the booking
DRY_RUN=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ---- Marine Park credentials ----
MARINE_PARK_EMAIL=your.email@example.com
MARINE_PARK_PASSWORD=your_password_here

# ---- Payment details ----
# Marine Park uses a saved card on the EZLinks account — no payment fields needed.
# For courses that require card entry at booking time, add payment config to
# courses.yaml and uncomment these:
# PAYMENT_CARD_NAME=John Doe
# PAYMENT_CARD_NUMBER=4111111111111111
# PAYMENT_CARD_EXPIRY=12/28
# PAYMENT_CARD_CVV=123
# PAYMENT_CARD_ZIP=11234

# ---- Email notifications ----
# Address to receive success/failure alerts
NOTIFY_EMAIL=your.email@example.com
# Gmail "From" address (must match SMTP login)
SMTP_FROM=your.gmail@gmail.com
# Gmail App Password (not your regular password — generate at myaccount.google.com/apppasswords)
SMTP_PASSWORD=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
